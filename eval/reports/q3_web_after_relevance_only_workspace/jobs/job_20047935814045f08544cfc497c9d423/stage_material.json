      {
        "name": "语境消歧案例：个人",
        "points": [
          {
            "evidence_id": "E-007",
            "statement": "「个人」一词的含义取决于具体语境。"
          },
          {
            "evidence_id": "E-008",
            "statement": "在「我个人认为」中，「个人」明确指说话者自己。"
          },
          {
            "evidence_id": "E-009",
            "statement": "在「个人有个人的看法」中，「个人」指不包括说话者在内的其他人。"
          },
          {
            "evidence_id": "E-010",
            "statement": "后一种用法强调个体之间的差异性和独立性。"
          },
          {
            "evidence_id": "E-011",
            "statement": "「个人」既可指自己，也可指不包括自己在内的其他人。"
          },
          {
            "evidence_id": "E-012",
            "statement": "该词具体含义需要根据上下文来判断。"
