      {
        "name": "个人术语与上下文消歧",
        "points": [
          {
            "evidence_id": "E-008",
            "statement": "“个人”一词的含义取决于具体语境。"
          },
          {
            "evidence_id": "E-009",
            "statement": "在“我个人认为”这类表述中，“个人”明确指说话者自己。"
          },
          {
            "evidence_id": "E-010",
            "statement": "在“个人有个人的看法”中，“个人”指许多人中的每一个，不含说话者。"
          },
          {
            "evidence_id": "E-011",
            "statement": "“个人”既可指代自己，也可指代不包括自己在内的其他人。"
          },
          {
            "evidence_id": "E-012",
            "statement": "“个人”的具体含义需根据上下文判断。"
          },
          {
            "evidence_id": "E-013",
            "statement": "同一词形在不同语境指向不同主体，检索与记录时需依赖上下文消歧。"
          }
        ]
      },
