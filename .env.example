# ============================================================
# 复制本文件为 .env 后填写真实值；.env 已被 .gitignore 忽略。
# API Key 只从环境读取，绝不写进源码或提交。
# ============================================================

# 模型供应商：deepseek / openai / openai-compatible / mock（仅支持 OpenAI 兼容协议）
MODEL_PROVIDER=deepseek

# 模型名
MODEL_NAME=deepseek-chat

# API Key（留空会阻止真实模式；离线运行必须明确选择 mock，不会自动回退）
MODEL_API_KEY=

# OpenAI 兼容接口地址（deepseek 官方：https://api.deepseek.com）
MODEL_BASE_URL=https://api.deepseek.com

# 采样温度
TEMPERATURE=0.7

# 单次生成最大 token
MAX_TOKENS=2048

# 追踪级别：TRACE / DEBUG / INFO / WARN / ERROR
TRACE_LEVEL=INFO

# Run 工作区根目录（相对本项目根目录）
WORKSPACE_DIR=workspaces

# ------------------------------------------------------------
# B4 搜索网关（S2-03/04）：全部留空=搜索禁用。
# 页面/CLI 显示“搜索未配置”，任务只用用户资料与指定链接，绝不假装搜过。
# 已接入 provider：bing_scrape（爬虫抓取 cn.bing.com 结果页，无需 Key，仅真实模式可用）、
# mock（仅离线演示）。其他值会被 health 判为未接入。
# ------------------------------------------------------------
SEARCH_PROVIDER=
SEARCH_API_KEY=
SEARCH_BASE_URL=
SEARCH_MAX_RESULTS=5

# O-14 域名降权换源（2026-09-18 B 方案）：逗号分隔的域名后缀名单，
# 命中站点搜索时降权（403 反爬高发站）；设为 none 可关闭降权（对照实验用）。
SEARCH_BLOCKED_DOMAINS=

# ------------------------------------------------------------
# MCP Client 接入（D2-04 / docs/MCP_USAGE.md）：JSON 数组，每项含
# name/command/args/allow_tools/deny_tools/tool_risk/default_side_effect。
# 留空/缺省=不启动任何 MCP Server（workspace_search 等工具来自本地 server，需配置后才注册）。
# 示例（本地只读 server）：
# MCP_SERVERS=[{"name":"local","command":"<python路径>","args":["-m","src.mcp.local_server"],"allow_tools":["workspace_search","memory_search"],"deny_tools":[],"tool_risk":"low","default_side_effect":false}]
# ------------------------------------------------------------
MCP_SERVERS=

# 知识库与技能目录覆盖（默认用项目内 knowledge/ 与 skills/，一般无需设置）
KNOWLEDGE_DIR=
SKILLS_DIR=

# 专职评测 Agent 的独立模型（S6-05）：留空=与被评任务同模型（标注 independence 局限）。
# 建议写作用 deepseek-v4-flash、评测用更强的 deepseek-v4-pro。
GRADER_MODEL_NAME=
